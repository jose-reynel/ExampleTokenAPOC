{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSql",
    "Initialization": "EnsureCreated",
    "MaxRetries": 10,
    "RetryDelaySeconds": 3
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=decoupledpayments;Username=dp_user;Password=dp_pass_dev"
  },
  "Jwt": {
    "Issuer": "decoupled-payments-auth",
    "Audience": "decoupled-payments-api",
    "TransactionTokenTtlSeconds": 60,
    "KeyId": "apoc-key-1"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7200",
      "http://localhost:5200"
    ]
  }
}
